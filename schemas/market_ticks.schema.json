{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MarketTick",
  "description": "A single market price/volume event for one symbol.",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "string",
      "description": "ISO-8601 UTC event time (e.g. 2026-09-04T10:32:15Z)"
    },
    "symbol": { "type": "string" },
    "price": { "type": "number" },
    "volume": { "type": "integer" },
    "bid": { "type": "number" },
    "ask": { "type": "number" }
  },
  "required": ["timestamp", "symbol", "price", "volume", "bid", "ask"],
  "additionalProperties": false
}

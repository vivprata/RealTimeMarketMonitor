# ------------------------------------------------------------------
# Confluent + watsonx.data Stock Market Demo — FinalDemo
# Copy to `.env` and fill in real values. NEVER commit the real .env.
# ------------------------------------------------------------------

# ---- Confluent Cloud: Kafka cluster ----
# Confluent Cloud > Environments > your-env > your-cluster >
#   Cluster Settings  -> Bootstrap server (copy the host:port)
#   API Keys          -> Create key, copy Key + Secret
CONFLUENT_BOOTSTRAP_SERVERS=pkc-xxxxx.region.provider.confluent.cloud:9092
CONFLUENT_API_KEY=YOUR_CLUSTER_API_KEY
CONFLUENT_API_SECRET=YOUR_CLUSTER_API_SECRET

# ---- Kafka topics (defaults match the Flink SQL and infra scripts) ----
TOPIC_MARKET_TICKS=market_ticks
TOPIC_MARKET_EVENTS=market_events
TOPIC_MARKET_SIGNALS=market_signals
TOPIC_PORTFOLIO_POSITIONS=portfolio_positions

# ---- Schema Registry ----
# Confluent Cloud > Environments > your-env > Schema Registry (right panel)
#   Endpoint URL (copy it)
#   API Keys > Create key, copy Key + Secret
SCHEMA_REGISTRY_URL=https://psrc-xxxxx.region.provider.confluent.cloud
SCHEMA_REGISTRY_API_KEY=YOUR_SR_API_KEY
SCHEMA_REGISTRY_API_SECRET=YOUR_SR_API_SECRET

# ---- AWS S3 (historical/reference data — same bucket as before) ----
AWS_REGION=us-east-1
S3_BUCKET=my-watsonx-demo-bucket
S3_PREFIX=stock-demo
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY

# ---- watsonx.data (Presto engine — same instance as before) ----
# From watsonx.data > Presto engine > Configuration > connection details
# NOTE: WXD_SCHEMA_STREAMING must be updated to the NEW Confluent cluster ID
#       (lkc-xxxxxx) after you create your new cluster.
WXD_HOST=your-presto-host.lakehouse.appdomain.cloud
WXD_PORT=443
WXD_USER=your-username-or-email
WXD_PASSWORD=YOUR_WXD_API_KEY_OR_PASSWORD
# Catalog names as registered in watsonx.data
WXD_CATALOG_STREAMING=confluent
WXD_SCHEMA_STREAMING=lkc-xxxxxxx
WXD_CATALOG_HISTORICAL=hive_catalog
WXD_SCHEMA_HISTORICAL=stock_demo

# ---- Simulator behavior ----
# Ticks per second across all symbols (spread evenly)
SIM_TICKS_PER_SECOND=18
# Back-fill this many minutes of history at startup so Flink's window is warm
SIM_WARMUP_MINUTES=10
# Random seed for deterministic, repeatable demos
SIM_SEED=42
